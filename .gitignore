# Generic heavy file protection (with test fixture exceptions)
*.npz
*.mol2
*.pdb
*.sdf
!tests/data/*.sdf
!tests/data/*.pdb
!data/casf2016/casf2016_core_285.txt
!data/casf2016/CoreSet.dat
!data/freesolv/database.txt

# Preserve benchmark summary artifacts and figures
!data/benchmarks/*
!data/benchmarks/figures/*
