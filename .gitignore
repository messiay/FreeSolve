__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
dist/
build/
.DS_Store
*.log
refined_pose.sdf
zenodo_query.json
~$*.docx

# Benchmark archive downloads (heavy binaries)
data/posebusters_paper/
data/posebusters_benchmark_50/
